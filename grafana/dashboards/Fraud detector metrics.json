      "targets": [
        {
          "dataset": "fraud_db",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-scores"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH recent AS (\n  SELECT cat_id, fraud_flag\n  FROM public.scores\n  ORDER BY created_at DESC\n  LIMIT 1000\n)\n\nSELECT\n  COALESCE(NULLIF(cat_id, ''), 'unk') AS cat_id,\n  SUM(CASE WHEN fraud_flag = 1 THEN 1 ELSE 0 END)::double precision / COUNT(*) AS fraud_ratio\nFROM recent\nGROUP BY cat_id\nORDER BY cat_id DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Fraud rate among categories, last 1000 transactions only",
      "type": "barchart"
