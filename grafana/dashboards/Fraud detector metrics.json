      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-scores"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(NULLIF(model_version, ''), 'unknown') AS model_version,\n  COUNT(*) AS scores_count,\n  COUNT(*) FILTER (WHERE fraud_flag = 1)::double precision\n    / COUNT(*) AS fraud_ratio\nFROM public.scores\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY MAX(created_at) DESC;",
          "refId": "A"
        }
      ],
      "title": "Scores and fraud by model version (PostgreSQL)",
      "type": "table"
