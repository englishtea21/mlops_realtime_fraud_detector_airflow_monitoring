# Fraud Detector
FRAUD_DETECTOR_THRESHOLD=0.9
FRAUD_AROUND_THRESHOLD_RADIUS=0.05
FRAUD_DETECTOR_PROM_PORT="8000"

# Score Writer
SCORE_WRITER_PROM_PORT="8001"

# PostgreSQL
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
METRICS_PORT=8000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SCORING_TOPIC=scoring

# CSV с размеченными транзакциями. Файл монтируется в data_loader и transaction_simulator.
TRAIN_DATA_CSV="/path/to/train.csv"
